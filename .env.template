# LibreTranslate settings (used by BOTH the main app for chat translation AND the
# transcriber service to auto-translate transcript chunks as they arrive).
# Use a URL reachable from the app process: same Docker network service name, LAN IP, or
# host machine via http://host.docker.internal:PORT (compose already maps host.docker.internal).
LIBRETRANSLATE_URL=http://YOUR_LIBRETRANSLATE_HOST:3006
DEFAULT_TARGET_LANG=en
LIBRETRANSLATE_API_KEY=

# Ollama settings for AI chat analysis
# OLLAMA_BASE_URL is the base URL of your Ollama instance (e.g. http://192.168.1.50:11434)
# OLLAMA_MODEL is the model to use for chat analysis (e.g. llama3.2)
# Leave OLLAMA_BASE_URL empty to disable AI analysis.
OLLAMA_BASE_URL=http://YOUR_OLLAMA_HOST:11434
OLLAMA_MODEL=llama3.2

# Optional: override data directory for SQLite
# DATA_DIR=./data

# Optional: disable TikTok WebSocket listeners (for docs / screenshot runs)
# DISABLE_TIKTOK_LISTENERS=false

# Optional: override Flask port
# PORT=5000

# Transcriber settings (audio transcription via Whisper, runs on the GPU container).
# TRANSCRIBER_URL is set automatically in docker-compose; override only for non-Docker setups.
# TRANSCRIBER_URL=http://localhost:5001
# Whisper model size: tiny / base / small / medium / large-v3.
# "medium" (~3 GB VRAM) is recommended for non-English livestreams: much better accuracy
# than "base" while still running real-time on modern NVIDIA GPUs.
WHISPER_MODEL=medium
# WHISPER_DEVICE=cuda
# TRANSCRIPT_CHUNK_SECONDS=30
